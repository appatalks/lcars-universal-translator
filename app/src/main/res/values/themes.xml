<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.LcarsTranslator" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/lcars_orange</item>
        <item name="colorPrimaryVariant">@color/lcars_peach</item>
        <item name="colorOnPrimary">@color/lcars_black</item>
        <item name="colorSecondary">@color/lcars_blue</item>
        <item name="colorSecondaryVariant">@color/lcars_purple</item>
        <item name="colorOnSecondary">@color/lcars_black</item>
        <item name="android:windowBackground">@color/lcars_black</item>
        <item name="android:statusBarColor">@color/lcars_black</item>
        <item name="android:navigationBarColor">@color/lcars_black</item>
        <item name="android:textColorPrimary">@color/lcars_orange</item>
        <item name="android:textColorSecondary">@color/lcars_tan</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <!-- LCARS Button Style -->
    <style name="Widget.Lcars.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/lcars_black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="backgroundTint">@color/lcars_orange</item>
    </style>

    <!-- LCARS Base Text Appearance (required parent for dot-notation children) -->
    <style name="TextAppearance.Lcars" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textColor">@color/lcars_orange</item>
    </style>

    <!-- LCARS Display Text Style -->
    <style name="TextAppearance.Lcars.Display" parent="TextAppearance.Lcars">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/lcars_orange</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <!-- LCARS Label Style -->
    <style name="TextAppearance.Lcars.Label" parent="TextAppearance.Lcars">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textColor">@color/lcars_tan</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- LCARS Title Style -->
    <style name="TextAppearance.Lcars.Title" parent="TextAppearance.Lcars">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textColor">@color/lcars_black</item>
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>